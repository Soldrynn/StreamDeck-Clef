{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.davedev.apple-music.playback.glass",
  "items": [
    {
      "key": "art",
      "type": "pixmap",
      "rect": [7, 8, 54, 54],
      "value": "assets/placeholders/album.svg",
      "zOrder": 1
    },
    {
      "key": "status",
      "type": "text",
      "rect": [69, 8, 123, 17],
      "value": "CONNECTING",
      "alignment": "left",
      "color": "#C8C8C8",
      "font": { "size": 10, "weight": 700 },
      "text-overflow": "ellipsis",
      "zOrder": 1
    },
    {
      "key": "track",
      "type": "text",
      "rect": [69, 25, 123, 22],
      "value": "Apple Music",
      "alignment": "left",
      "color": "#FFFFFF",
      "font": { "size": 16, "weight": 700 },
      "text-overflow": "ellipsis",
      "zOrder": 1
    },
    {
      "key": "artist",
      "type": "text",
      "rect": [69, 48, 123, 15],
      "value": "Waiting for playback",
      "alignment": "left",
      "color": "#D2D2D2",
      "font": { "size": 10, "weight": 500 },
      "text-overflow": "ellipsis",
      "zOrder": 1
    },
    {
      "key": "progress",
      "type": "bar",
      "rect": [7, 73, 186, 9],
      "value": 0,
      "range": { "min": 0, "max": 1000 },
      "bar_bg_c": "#292929",
      "bar_fill_c": "0:#9A9A9A,1:#E2E2E2",
      "bar_border_c": "#5E5E5E",
      "border_w": 1,
      "subtype": 4,
      "zOrder": 1
    },
    {
      "key": "time",
      "type": "text",
      "rect": [7, 85, 186, 13],
      "value": "--:--  /  --:--",
      "alignment": "right",
      "color": "#BBBBBB",
      "font": { "size": 9, "weight": 500 },
      "zOrder": 1
    }
  ]
}
